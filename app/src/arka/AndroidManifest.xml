<?xml version="1.0" encoding="utf-8"?>
<!--
  Tiklat Arka Koltuk: ön koltuk başlığının arkasındaki Android Auto ekranı için.
  Ders İzle gibi park uygulaması olarak kayıtlı (Play kaydı gerekmeden listede görünür).
  distractionOptimized: Android Auto'ya bu ekranın sürüşte de açık kalabileceğini bildirir.
  İçerik, telefonda "ekran arka koltukta" onayı verilmeden gösterilmez.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:appCategory="game">
        <meta-data
            android:name="distractionOptimized"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <activity
            android:name=".AyarlarActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
